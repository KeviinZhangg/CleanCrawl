# Database — SQLite locally, Postgres in cloud
DATABASE_URL=sqlite:///cleancrawl.db
# DATABASE_URL=postgresql+psycopg2://cleancrawl:cleancrawl@localhost:5432/cleancrawl

# HTTP server
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Crawler identity
USER_AGENT=CleanCrawlBot/1.0 (+https://example.com/cleancrawlbot)

# Playwright JS fallback (off by default — large Docker image if enabled)
ENABLE_BROWSER=false

# Public API safety: max seed URLs per crawl request
MAX_CRAWL_SEEDS=30

# Performance tuning (optional overrides)
# MAX_CONCURRENCY=8
# DEFAULT_CRAWL_DELAY=1.5
# PER_DOMAIN_BUDGET=500
